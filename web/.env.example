ESP32_BASE_URL=http://192.168.1.108
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
# Optional: external TTS service; leave unset to run local Thai TTS in the web process.
# TTS_BASE_URL=http://127.0.0.1:8765
DATABASE_PATH=./data/luma.sqlite

# Required before using the browser-callable /api/v1/* API. Generate a random
# key of at least 32 characters and share it privately, never in a public repo.
# LUMA_API_KEY=replace-with-a-long-random-secret
# Comma-separated exact origins of friends' frontends; * permits any origin
# with a valid key and is only suitable for a controlled development network.
# LUMA_API_ORIGINS=http://localhost:5173
# For an API-only public deployment, block the old unauthenticated /api/* routes.
# The VPS Compose setup instead sets this to 0 because Caddy protects the
# original site and old API with Basic Auth. Never expose Next.js port 3000.
# LUMA_PUBLIC_API_ONLY=1
