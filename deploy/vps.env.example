# Copy this file to .env at the repository root on the VPS. Never commit .env.
LUMA_SITE_DOMAIN=
LUMA_ADMIN_USER=owner
# Generate interactively with: docker run -it --rm caddy:2 caddy hash-password
# Keep the bcrypt value single-quoted so Compose does not expand its $ signs.
LUMA_ADMIN_PASSWORD_HASH=

# Generate with: openssl rand -hex 32
LUMA_API_KEY=
# Exact browser origins, comma-separated; do not use * on a public host.
LUMA_API_ORIGINS=

# The Pi exposes its loopback-only Ollama port privately with Tailscale Serve.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:0.6b
# This single LAN IP is routed through the Pi's Tailscale subnet route.
ESP32_BASE_URL=
